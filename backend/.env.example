# ==============================================================================
# DHA Vault Backend Environment Variables Template (Production & Development)
# NOTE: Never commit production values or secrets to source control.
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=4000
CORS_ORIGIN=*

# PostgreSQL Database (Render Managed Postgres Connection String)
# Internal URL (Render to Render): postgresql://<user>:<password>@<host>/<database>
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/dha_vault

# JWT Authentication Secrets (Must be 32+ character high-entropy keys)
JWT_ACCESS_SECRET=replace_with_a_secure_random_production_key_32_chars_min
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_key_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application Identity
APP_NAME=DHA Vault
APP_URL=https://<your-render-service>.onrender.com

# Document Storage (Cloudflare R2 or AWS S3 Compatible)
# Set STORAGE_PROVIDER=s3 for Cloudflare R2 in production, or 'local' for local development
STORAGE_PROVIDER=s3
STORAGE_PATH=./uploads

# Cloudflare R2 / S3 Credentials
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=dha-vault-private
R2_REGION=auto

# Optional S3 variable aliases (same as R2)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
S3_BUCKET=dha-vault-private
S3_REGION=auto

# Google OAuth 2.0 Credentials
# From Google Cloud Console -> Credentials
GOOGLE_CLIENT_ID=<WEB_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=<ANDROID_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<WEB_CLIENT_SECRET>

# Gmail SMTP Email Notification Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_verified_account@gmail.com
SMTP_APP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_NAME="DHA Vault"
SMTP_FROM_EMAIL=your_verified_account@gmail.com
